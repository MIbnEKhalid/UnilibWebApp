<!-- ================================================================ -->
<!-- Admin Panel Sidebar — mbkbucket-inspired Glassmorphism           -->
<!-- ================================================================ -->
<aside id="adminSidebar" class="admin-sidebar" aria-label="Admin Navigation">

  <!-- Sidebar Header -->
  <div class="admin-sidebar-header">
    <div style="display:flex;align-items:center;justify-content:space-between;gap:0.5rem;">
      <div style="display:flex;align-items:center;gap:0.65rem;min-width:0;">
        <div style="width:32px;height:32px;border-radius:8px;background:var(--primary,#0f766e);color:#fff;display:flex;align-items:center;justify-content:center;box-shadow:0 2px 6px rgba(15,118,110,0.25);flex-shrink:0;">
          <i class="fas fa-sliders" style="font-size:12px;"></i>
        </div>
        <div style="min-width:0;">
          <div style="display:flex;align-items:center;gap:0.35rem;">
            <span style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;color:var(--primary-dk,#0b4f4a);background:var(--primary-lt,#d7f4ee);padding:1px 6px;border-radius:4px;border:1px solid rgba(15,118,110,0.20);">Console</span>
            <span style="display:inline-block;width:6px;height:6px;border-radius:50%;background:#10b981;flex-shrink:0;" title="System Operational"></span>
          </div>
          <h2 style="font-size:13px;font-weight:700;color:var(--text,#1f2a2a);font-family:var(--font-headings);letter-spacing:-0.01em;line-height:1.2;margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">Admin Panel</h2>
        </div>
      </div>

      <!-- Mobile Close Button -->
      <button type="button" onclick="toggleAdminSidebar(false)" class="admin-sidebar-close-btn" aria-label="Close sidebar">
        <i class="fas fa-times"></i>
      </button>
    </div>
  </div>

  <!-- Scrollable Nav Section -->
  <div class="admin-sidebar-nav custom-scrollbar">

    <!-- Group 1: Core Registries -->
    <div class="admin-nav-group">
      <span class="admin-nav-group-title">Core Registries</span>

      <!-- Publications Registry -->
      <a href="/dashboard/books" class="admin-nav-item {{#if isBooksAdmin}}{{#unless isAddBookPage}}active{{/unless}}{{/if}}" id="sidebar-link-publications">
        <div class="admin-nav-icon">
          <i class="fas fa-book-bookmark"></i>
        </div>
        <div class="admin-nav-content">
          <span class="admin-nav-label">Publications</span>
          <span class="admin-nav-sub">Books & Catalog</span>
        </div>
        {{#if dashboardStats.total}}
        <span class="admin-nav-badge">{{dashboardStats.total}}</span>
        {{/if}}
      </a>

      <!-- Course Materials -->
      <a href="/dashboard/materials" class="admin-nav-item {{#if isMaterialsAdmin}}active{{/if}}" id="sidebar-link-materials">
        <div class="admin-nav-icon">
          <i class="fas fa-folder-tree"></i>
        </div>
        <div class="admin-nav-content">
          <span class="admin-nav-label">Course Materials</span>
          <span class="admin-nav-sub">Subjects & Files</span>
        </div>
        {{#if totalMaterialsFiles}}
        <span class="admin-nav-badge">{{totalMaterialsFiles}}</span>
        {{/if}}
      </a>

      <!-- Add Publication -->
      <a href="/dashboard/books/new" class="admin-nav-item {{#if isAddBookPage}}active{{/if}}" id="sidebar-link-add-book">
        <div class="admin-nav-icon">
          <i class="fas fa-circle-plus"></i>
        </div>
        <div class="admin-nav-content">
          <span class="admin-nav-label">New Publication</span>
          <span class="admin-nav-sub">Register Entry</span>
        </div>
      </a>

      <!-- SQLite AdminDB -->
      <a href="/dashboard/db" target="_blank" rel="noopener noreferrer" class="admin-nav-item {{#if isDbAdmin}}active{{/if}}" id="sidebar-link-db">
        <div class="admin-nav-icon">
          <i class="fas fa-database"></i>
        </div>
        <div class="admin-nav-content">
          <span class="admin-nav-label">Database Console</span>
          <span class="admin-nav-sub">SQLite UI (AdminDB)</span>
        </div>
        <i class="fas fa-arrow-up-right-from-square" style="font-size:9px;color:rgba(15,118,110,0.6);margin-left:auto;"></i>
      </a>
    </div>

    <!-- Group 2: Curriculum Fast Jumps -->
    <div class="admin-nav-group">
      <span class="admin-nav-group-title">Curriculum Filters</span>
      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:0.35rem;padding:0.15rem 0.25rem;">
        <a href="/dashboard?semester=all" class="admin-sem-jump-pill" title="View All Semesters">All</a>
        <a href="/dashboard?semester=Semester+1" class="admin-sem-jump-pill" title="Semester 1">Sem 1</a>
        <a href="/dashboard?semester=Semester+2" class="admin-sem-jump-pill" title="Semester 2">Sem 2</a>
        <a href="/dashboard?semester=Semester+3" class="admin-sem-jump-pill" title="Semester 3">Sem 3</a>
        <a href="/dashboard?semester=Semester+4" class="admin-sem-jump-pill" title="Semester 4">Sem 4</a>
        <a href="/dashboard?semester=Semester+5" class="admin-sem-jump-pill" title="Semester 5">Sem 5</a>
        <a href="/dashboard?semester=Semester+6" class="admin-sem-jump-pill" title="Semester 6">Sem 6</a>
        <a href="/dashboard?semester=Semester+7" class="admin-sem-jump-pill" title="Semester 7">Sem 7</a>
        <a href="/dashboard?semester=Semester+8" class="admin-sem-jump-pill" title="Semester 8">Sem 8</a>
      </div>
    </div>

    <!-- Group 3: Quick Admin Actions -->
    <div class="admin-nav-group">
      <span class="admin-nav-group-title">Quick Actions</span>

      <!-- Export Catalog -->
      <button type="button" onclick="adminSidebarExportCatalog()" class="admin-nav-item w-full text-left" id="sidebar-btn-export" style="width:100%;border:none;">
        <div class="admin-nav-icon" style="color:#d97706;background:#fffbeb;border-color:#fde68a;">
          <i class="fas fa-file-export"></i>
        </div>
        <div class="admin-nav-content">
          <span class="admin-nav-label">Export Catalog</span>
          <span class="admin-nav-sub">Download JSON Backup</span>
        </div>
      </button>

      <!-- Sync Tasjeel -->
      <button type="button" onclick="adminSidebarSyncTasjeel()" class="admin-nav-item w-full text-left" id="sidebar-btn-sync" style="width:100%;border:none;">
        <div class="admin-nav-icon" style="color:#0f766e;background:var(--primary-lt,#d7f4ee);border-color:rgba(15,118,110,0.22);">
          <i class="fas fa-rotate" id="sidebarSyncIcon"></i>
        </div>
        <div class="admin-nav-content">
          <span class="admin-nav-label">Sync Tasjeel</span>
          <span class="admin-nav-sub">Update Materials Crawler</span>
        </div>
      </button>
    </div>

    <!-- Group 4: Public Views -->
    <div class="admin-nav-group">
      <span class="admin-nav-group-title">Public Views</span>

      <a href="/" target="_blank" rel="noopener noreferrer" class="admin-nav-item" id="sidebar-link-public-catalog">
        <div class="admin-nav-icon">
          <i class="fas fa-compass"></i>
        </div>
        <div class="admin-nav-content">
          <span class="admin-nav-label">Public Catalog</span>
          <span class="admin-nav-sub">Student Books View</span>
        </div>
        <i class="fas fa-arrow-up-right-from-square" style="font-size:9px;color:rgba(15,118,110,0.6);margin-left:auto;"></i>
      </a>

      <a href="/materials" target="_blank" rel="noopener noreferrer" class="admin-nav-item" id="sidebar-link-public-materials">
        <div class="admin-nav-icon">
          <i class="fas fa-graduation-cap"></i>
        </div>
        <div class="admin-nav-content">
          <span class="admin-nav-label">Public Materials</span>
          <span class="admin-nav-sub">Student Archives</span>
        </div>
        <i class="fas fa-arrow-up-right-from-square" style="font-size:9px;color:rgba(15,118,110,0.6);margin-left:auto;"></i>
      </a>

      <a href="https://mbktech.org/" target="_blank" rel="noopener noreferrer" class="admin-nav-item" id="sidebar-link-mbktech">
        <div class="admin-nav-icon">
          <i class="fas fa-globe"></i>
        </div>
        <div class="admin-nav-content">
          <span class="admin-nav-label">MBK Tech Hub</span>
          <span class="admin-nav-sub">Main Ecosystem</span>
        </div>
        <i class="fas fa-arrow-up-right-from-square" style="font-size:9px;color:rgba(15,118,110,0.6);margin-left:auto;"></i>
      </a>
    </div>

  </div>

  <!-- Sidebar Footer / System Badge -->
  <div class="admin-sidebar-footer">
    <div style="padding:0.55rem 0.75rem;border-radius:8px;background:var(--primary-lt,#d7f4ee);border:1px solid rgba(15,118,110,0.20);font-size:12px;">
      <div style="display:flex;align-items:center;justify-content:space-between;font-size:11px;font-weight:600;color:var(--text,#1f2a2a);">
        <span style="display:flex;align-items:center;gap:0.35rem;">
          <i class="fas fa-server" style="font-size:10px;color:var(--primary,#0f766e);"></i>
          Unilib Core
        </span>
        <span style="color:var(--primary-dk,#0b4f4a);font-family:var(--font-mono, monospace);font-size:10px;">v{{appVersion}}</span>
      </div>
      <div style="display:flex;align-items:center;justify-content:space-between;margin-top:0.3rem;font-size:10px;color:var(--text-muted,#667c79);">
        <span>Session Active</span>
        <button style="color:#dc2626;background:none;border:none;font-weight:700;cursor:pointer;padding:0;font-size:10px;" onclick="logout()" title="Log Out">Logout</button>
      </div>
    </div>
  </div>

</aside>

<!-- Global Action Handlers for Sidebar Buttons -->
<script>
  function toggleAdminSidebar(show) {
    const sidebar = document.getElementById('adminSidebar');
    const backdrop = document.getElementById('adminSidebarBackdrop');
    if (!sidebar) return;
    const isCurrentlyOpen = sidebar.classList.contains('open');
    const targetState = typeof show === 'boolean' ? show : !isCurrentlyOpen;
    if (targetState) {
      sidebar.classList.add('open');
      if (backdrop) backdrop.classList.add('open');
      document.body.style.overflow = window.innerWidth < 1024 ? 'hidden' : '';
    } else {
      sidebar.classList.remove('open');
      if (backdrop) backdrop.classList.remove('open');
      document.body.style.overflow = '';
    }
  }

  // Close sidebar when pressing Escape
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      const sidebar = document.getElementById('adminSidebar');
      if (sidebar && sidebar.classList.contains('open')) {
        toggleAdminSidebar(false);
      }
    }
  });

  async function adminSidebarExportCatalog() {
    try {
      showToast('Preparing catalog export...', 'info');
      const r = await fetch('/api/admin/books/export', { credentials: 'include' });
      if (!r.ok) throw new Error('Export failed');
      const data = await r.json();
      const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `unilib_catalog_${new Date().toISOString().slice(0, 10)}.json`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
      showToast('Catalog exported successfully!', 'success');
    } catch (err) {
      console.error(err);
      showToast('Failed to export catalog.', 'error');
    }
  }

  async function adminSidebarSyncTasjeel() {
    const icon = document.getElementById('sidebarSyncIcon');
    if (icon) icon.classList.add('fa-spin');
    showToast('Starting Tasjeel materials crawler sync...', 'info');

    try {
      const resp = await fetch('/api/admin/materials/sync-tasjeel', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json' }
      });
      const data = await resp.json();
      if (!resp.ok || !data.success) {
        throw new Error(data.message || 'Sync failed');
      }
      showToast(data.message || 'Tasjeel sync completed successfully!', 'success');
      setTimeout(() => window.location.reload(), 1200);
    } catch (err) {
      console.error('Tasjeel sync error:', err);
      showToast(err.message || 'Failed to sync with Tasjeel.', 'error');
    } finally {
      if (icon) icon.classList.remove('fa-spin');
    }
  }
</script>
