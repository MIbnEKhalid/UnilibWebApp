{
  "name": "unilibwebapp",
  "version": "2.6.0",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon -e js,mjs,cjs,json,handlebars src/server.js",
    "sync_permissions": "node scripts/sync_permissions.js",
    "convertToWebp": "node scripts/convertToWebp.js",
    "convertPageImages": "node scripts/convertPageImages.js",
    "db:init": "node scripts/initDb.js",
    "db:init:postgres": "node scripts/initDb.js --type=postgres",
    "db:init:sqlite": "node scripts/initDb.js --type=sqlite",
    "test": "vitest run"
  },
  "author": "Muhammad Bin Khalid",
  "license": "MIT",
  "dependencies": {
    "@upstash/redis": "^1.39.0",
    "admindb": "latest",
    "better-sqlite3": "13.0.3",
    "cheerio": "^1.1.2",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-handlebars": "^9.0.1",
    "express-rate-limit": "^8.7.0",
    "mbkauthe": "latest",
    "mbkbucket": "latest",
    "node-cron": "^4.6.0",
    "pdf-lib": "^1.17.1",
    "pdf-to-img": "^7.0.0",
    "pg": "^8.23.1",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/supertest": "^7.2.1",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1",
    "vite": "^8.3.2",
    "vitest": "5.0.3"
  }
}
