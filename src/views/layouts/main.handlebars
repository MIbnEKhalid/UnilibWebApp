<!DOCTYPE html>
<html lang="en" dir="ltr">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description"
    content="{{#if singleBookView}}{{#each books}}{{this.name}} - {{this.description}}{{/each}}{{else}}Access university course materials, books, lab manuals, and assignments on Unilib.{{/if}}">
  <meta name="keywords" content="Unilib, mbktech.org, Course Materials, Books, Lab Manuals, Assignments, University, Open-Source">
  <meta property="og:title" content="Unilib | University Course Materials & Resources" />
  <meta property="og:description"
    content="Empowering academic growth through open-source education and organized course resources." />
  <meta property="og:image" content="https://mbktech.org/Assets/Images/Icon/logo.png" />
  <meta property="og:url" content="https://mbktech.org/">
  <meta name="robots" content="noindex, follow">

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "EducationalOrganization",
      "name": "Unilib - mbktech.org",
      "url": "https://mbktech.org/",
      "logo": "https://mbktech.org/Assets/Images/Icon/logo.png",
      "description": "Empowering students through accessible academic course materials and open-source innovation."
    }
  </script>

  <link rel="icon" type="image/svg+xml" href="/Assets/icon.svg">

  <!-- Google Fonts: Sora (Headings) + IBM Plex Sans (Body) + JetBrains Mono (Code) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700;800&family=IBM+Plex+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

  <!-- FontAwesome 6 Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />

  <!-- Compiled Tailwind CSS & Theme Stylesheet -->
  <link rel="stylesheet" href="/Assets/Styles/tailwind.css?v={{appVersion}}">
  <link rel="stylesheet" href="/Assets/Styles/theme.css?v={{appVersion}}">
  <link rel="stylesheet" href="/Assets/Styles/common-admin.css?v={{appVersion}}">

  <script src="/mbkauthe/main.js" defer></script>
  <script>
    window.DEFAULT_SEMESTER = "{{defaultSemester}}";
  </script>
  <script src="/Assets/Scripts/unilib.js?v={{appVersion}}" defer></script>

  {{{_sections.head}}}

  <title>{{#if singleBookView}}{{#each books}}{{this.name}} - {{/each}}{{/if}}Unilib | Academic University Library</title>
</head>

<body>

  <!-- ================================================================ -->
  <!-- Modern Glassmorphic Header Navigation                            -->
  <!-- ================================================================ -->
  <header style="position:sticky;top:0;z-index:50;width:100%;background:rgba(255,255,255,0.85);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border-bottom:1px solid rgba(15,118,110,0.12);box-shadow:0 4px 6px -1px rgba(0,0,0,0.05),0 2px 4px -1px rgba(0,0,0,0.03);" id="mainHeader">

    <!-- Teal accent top bar -->
    <div style="height:3px;background:linear-gradient(90deg,#0f766e,#1f8f84,#0f766e);width:100%;"></div>

    <div style="max-width:1400px;margin:0 auto;padding:0 1.25rem;height:60px;display:flex;align-items:center;justify-content:space-between;gap:1rem;">

      <!-- Brand Logo -->
      <a href="/" style="display:flex;align-items:center;gap:0.6rem;text-decoration:none;flex-shrink:0;" id="brand-logo">
        <div style="width:36px;height:36px;border-radius:8px;background:var(--primary);display:flex;align-items:center;justify-content:center;box-shadow:0 2px 8px rgba(15,118,110,0.28);border:1px solid var(--primary-dk);">
          <i class="fas fa-book-open" style="color:#d7f4ee;font-size:14px;"></i>
        </div>
        <div style="display:flex;flex-direction:column;line-height:1.15;">
          <span style="font-family:'Sora',sans-serif;font-weight:800;font-size:1.15rem;color:#0b4f4a;letter-spacing:-0.02em;">
            Uni<span style="color:var(--primary);">lib</span>
          </span>
          <span style="font-size:9px;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.1em;">MBKTech.org</span>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <nav style="display:none;" id="desktopNav" class="md-nav">
        <a href="/" class="nav-link" id="nav-catalog">
          <i class="fas fa-book-bookmark nav-icon"></i>
          <span>Catalog</span>
        </a>
        <a href="/materials" class="nav-link" id="nav-materials">
          <i class="fas fa-archive nav-icon"></i>
          <span>Materials</span>
        </a>
        <a href="https://mbktech.org/" target="_blank" class="nav-link" id="nav-mbktech">
          <i class="fas fa-arrow-up-right-from-square nav-icon"></i>
          <span>MBK Tech</span>
        </a>
        <a href="/dashboard" class="nav-link" id="nav-admin">
          <i class="fas fa-compass nav-icon"></i>
          <span>Admin</span>
        </a>

        <div style="margin-left:0.75rem;padding-left:0.75rem;border-left:1px solid rgba(15,118,110,0.15);display:flex;align-items:center;">
          {{> profilemenu}}
        </div>
      </nav>

      <!-- Mobile Toggle -->
      <div style="display:flex;align-items:center;gap:0.5rem;" id="mobileToggleWrap">
        <button id="mobileMenuToggle" type="button" aria-label="Toggle Navigation Menu"
          style="width:36px;height:36px;border-radius:8px;background:rgba(255,255,255,0.85);border:1px solid rgba(15,118,110,0.20);color:var(--text-2);display:flex;align-items:center;justify-content:center;cursor:pointer;transition:all 0.15s ease;"
          onmouseenter="this.style.background='var(--primary-lt)';this.style.borderColor='var(--primary)'"
          onmouseleave="this.style.background='rgba(255,255,255,0.85)';this.style.borderColor='rgba(15,118,110,0.20)'">
          <i class="fas fa-bars" style="font-size:13px;" id="menuIcon"></i>
        </button>
      </div>

    </div>

    <!-- Mobile Drawer -->
    <div id="mobileDrawer" style="display:none;border-top:1px solid rgba(15,118,110,0.12);background:rgba(255,255,255,0.96);backdrop-filter:blur(12px);padding:1rem 1.25rem;">
      <div style="display:flex;flex-direction:column;gap:0.35rem;">
        <a href="/" class="mobile-nav-link" id="mobile-nav-catalog">
          <i class="fas fa-book-bookmark" style="width:16px;color:var(--text-muted);"></i>
          <span>Course Catalog</span>
        </a>
        <a href="/materials" class="mobile-nav-link" id="mobile-nav-materials">
          <i class="fas fa-archive" style="width:16px;color:var(--text-muted);"></i>
          <span>Materials Archive</span>
        </a>
        <a href="https://mbktech.org/" target="_blank" class="mobile-nav-link" id="mobile-nav-mbktech">
          <i class="fas fa-globe" style="width:16px;color:var(--text-muted);"></i>
          <span>MBK Tech</span>
        </a>
        <a href="/dashboard" class="mobile-nav-link" id="mobile-nav-admin">
          <i class="fas fa-compass" style="width:16px;color:var(--text-muted);"></i>
          <span>Admin Dashboard</span>
        </a>
      </div>
    </div>
  </header>

  <!-- Inline nav styles (avoids Tailwind purge issues with dynamic classes) -->
  <style>
    @media (min-width: 768px) {
      #desktopNav { display: flex !important; align-items: center; gap: 0.25rem; }
      #mobileToggleWrap { display: none !important; }
    }
    .nav-link {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      padding: 0.42rem 0.9rem;
      border-radius: 8px;
      font-size: 12px;
      font-weight: 600;
      color: var(--text-2);
      text-decoration: none;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      transition: all 0.15s ease;
      white-space: nowrap;
    }
    .nav-link:hover {
      color: var(--primary-dk);
      background: var(--primary-lt);
    }
    .nav-icon { font-size: 11px; color: var(--text-muted); }
    .mobile-nav-link {
      display: flex;
      align-items: center;
      gap: 0.65rem;
      padding: 0.55rem 0.75rem;
      border-radius: 8px;
      color: var(--text-2);
      font-size: 13px;
      font-weight: 600;
      text-decoration: none;
      transition: all 0.15s ease;
    }
    .mobile-nav-link:hover {
      background: var(--primary-lt);
      color: var(--primary-dk);
    }
  </style>

  <!-- ================================================================ -->
  <!-- Main Body Content                                                 -->
  <!-- ================================================================ -->
  {{#if isAdminPage}}
  <!-- Admin Layout Shell with Sidebar -->
  <div id="adminSidebarBackdrop" onclick="toggleAdminSidebar(false)"></div>
  <div class="admin-shell" style="flex:1;width:100%;max-width:1600px;margin:0 auto;padding:1.25rem 1.25rem 3rem;" id="admin-shell-container">
    {{> adminsidebar}}
    <main class="admin-main-pane" id="main-content">
      <!-- Mobile Bar to open Admin Sidebar on smaller screens -->
      <div class="admin-mobile-bar">
        <button type="button" onclick="toggleAdminSidebar(true)" class="admin-mobile-toggle-btn" id="mobileAdminMenuBtn">
          <i class="fas fa-sliders text-xs"></i>
          <span>Admin Menu</span>
        </button>
        <span class="text-xs font-semibold text-teal-900/80 flex items-center gap-1.5 font-headings">
          <i class="fas fa-shield-halved text-teal-600"></i>
          Admin Portal
        </span>
      </div>
      {{{body}}}
    </main>
  </div>
  {{else}}
  <main style="flex:1;width:100%;max-width:1400px;margin:0 auto;padding:1.5rem 1.25rem 2.5rem;" id="main-content">
    {{{body}}}
  </main>
  {{/if}}

  <!-- ================================================================ -->
  <!-- Quick-View Book Modal                                             -->
  <!-- ================================================================ -->
  <div id="quickViewBackdrop" class="quick-view-backdrop">
    <div class="quick-view-modal" style="padding:1.75rem;">
      <button onclick="closeQuickView()" id="qv-close-btn"
        style="position:absolute;top:1rem;right:1rem;width:32px;height:32px;border-radius:8px;background:rgba(15,118,110,0.08);border:1px solid rgba(15,118,110,0.16);color:var(--text-muted);display:flex;align-items:center;justify-content:center;cursor:pointer;transition:all 0.15s ease;font-size:13px;"
        aria-label="Close modal"
        onmouseenter="this.style.background='var(--primary)';this.style.color='#fff'"
        onmouseleave="this.style.background='rgba(15,118,110,0.08)';this.style.color='var(--text-muted)'">
        <i class="fas fa-times"></i>
      </button>

      <div style="display:grid;grid-template-columns:1fr;gap:1.5rem;">

        <!-- Cover -->
        <div id="qv-cover-col" style="display:flex;flex-direction:column;align-items:center;">
          <div style="width:100%;max-width:180px;aspect-ratio:3/4;border-radius:10px;overflow:hidden;border:1px solid var(--border);box-shadow:var(--shadow-md);background:rgba(215,244,238,0.30);position:relative;display:flex;align-items:center;justify-content:center;padding:0.65rem;">
            <div id="qvCoverBlur" style="position:absolute;inset:0;background-size:cover;background-position:center;opacity:0.15;filter:blur(12px);transform:scale(1.1);pointer-events:none;"></div>
            <img id="qvCover" src="/BookCovers/BookCover_Template.webp" alt="Book Cover" style="position:relative;z-index:1;max-height:100%;max-width:100%;object-fit:contain;border-radius:4px;box-shadow:var(--shadow);"/>
          </div>
          <div style="margin-top:0.65rem;text-align:center;">
            <span id="qvViews" style="font-size:11px;color:var(--text-muted);background:rgba(255,255,255,0.80);padding:2px 10px;border-radius:20px;border:1px solid var(--border);font-family:var(--font);">0 views</span>
          </div>
        </div>

        <!-- Metadata -->
        <div style="space-y:1rem;">
          <div style="display:flex;flex-wrap:wrap;gap:0.4rem;margin-bottom:0.6rem;">
            <span id="qvSemester" style="padding:2px 10px;border-radius:20px;font-size:11px;font-weight:700;background:var(--primary-lt);color:var(--primary-dk);border:1px solid rgba(15,118,110,0.22);">Semester</span>
            <span id="qvCategory" style="padding:2px 10px;border-radius:20px;font-size:11px;font-weight:600;background:rgba(255,255,255,0.80);color:var(--text-2);border:1px solid var(--border);">Category</span>
          </div>
          <h2 id="qvTitle" style="font-family:var(--font-headings);font-weight:700;font-size:1.35rem;color:var(--text);line-height:1.3;margin-bottom:0.5rem;">Book Title</h2>
          <p id="qvDescription" style="font-size:13px;color:var(--text-2);line-height:1.65;max-height:140px;overflow-y:auto;white-space:pre-line;margin-bottom:1rem;">Book description...</p>

          <!-- Actions -->
          <div style="padding-top:1rem;border-top:1px solid var(--border-lt);display:flex;flex-wrap:wrap;gap:0.5rem;">
            <button id="qvReadLink"
              style="display:inline-flex;align-items:center;gap:0.45rem;padding:8px 18px;border-radius:8px;background:var(--primary);color:#fff;font-weight:600;font-size:13px;border:none;cursor:pointer;box-shadow:0 2px 8px rgba(15,118,110,0.24);transition:all 0.15s ease;"
              onmouseenter="this.style.background='var(--primary-dk)';this.style.transform='translateY(-1px)'"
              onmouseleave="this.style.background='var(--primary)';this.style.transform='translateY(0)'">
              <i class="fas fa-book-reader"></i>
              <span>Read Online</span>
            </button>

            <button id="qvDownloadBtn"
              style="display:inline-flex;align-items:center;gap:0.45rem;padding:8px 16px;border-radius:8px;background:rgba(22,163,74,0.90);color:#fff;font-weight:600;font-size:13px;border:none;cursor:pointer;box-shadow:0 2px 8px rgba(22,163,74,0.20);transition:all 0.15s ease;"
              onmouseenter="this.style.background='#15803d'"
              onmouseleave="this.style.background='rgba(22,163,74,0.90)'">
              <i class="fas fa-download"></i>
              <span>Download</span>
            </button>

            <a id="qvFullPageLink" href="#"
              style="display:inline-flex;align-items:center;gap:0.35rem;padding:8px 14px;border-radius:8px;background:rgba(255,255,255,0.85);color:var(--text-2);border:1px solid var(--border);font-size:12px;font-weight:600;text-decoration:none;transition:all 0.15s ease;"
              onmouseenter="this.style.background='var(--primary-lt)';this.style.color='var(--primary-dk)';this.style.borderColor='var(--primary)'"
              onmouseleave="this.style.background='rgba(255,255,255,0.85)';this.style.color='var(--text-2)';this.style.borderColor='var(--border)'">
              <span>View Full Entry</span>
              <i class="fas fa-arrow-right" style="font-size:10px;"></i>
            </a>
          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- Quick View grid fix for larger screens -->
  <style>
    @media (min-width: 480px) {
      #quickViewBackdrop .quick-view-modal > div {
        grid-template-columns: auto 1fr !important;
      }
    }
  </style>

  <!-- ================================================================ -->
  <!-- Modern Footer                                                     -->
  <!-- ================================================================ -->
  <footer style="width:100%;background:rgba(255,255,255,0.82);backdrop-filter:blur(14px);border-top:1px solid rgba(15,118,110,0.14);margin-top:4rem;padding:3rem 1.25rem 1.75rem;" id="main-footer">
    <div style="max-width:1400px;margin:0 auto;">

      <div style="display:grid;grid-template-columns:1fr;gap:2rem;padding-bottom:2rem;border-bottom:1px solid rgba(15,118,110,0.12);" id="footer-grid">

        <!-- Brand -->
        <div style="display:flex;flex-direction:column;gap:0.85rem;">
          <div style="display:flex;align-items:center;gap:0.6rem;">
            <div style="width:32px;height:32px;border-radius:8px;background:var(--primary);display:flex;align-items:center;justify-content:center;box-shadow:0 2px 6px rgba(15,118,110,0.22);">
              <i class="fas fa-book-open" style="color:#d7f4ee;font-size:12px;"></i>
            </div>
            <span style="font-family:var(--font-headings);font-weight:800;font-size:1.1rem;color:var(--primary-dk);">
              Uni<span style="color:var(--primary);">lib</span>
            </span>
          </div>
          <p style="font-size:12px;color:var(--text-muted);line-height:1.7;max-width:300px;">
            An open-source academic repository of curriculum textbooks, laboratory manuals, and educational resources for university students.
          </p>
          <div style="display:flex;gap:0.5rem;padding-top:0.25rem;">
            <a href="https://github.com/MIbnEKhalid" target="_blank" aria-label="GitHub Profile"
              style="width:32px;height:32px;border-radius:8px;border:1px solid var(--border);background:rgba(255,255,255,0.85);display:flex;align-items:center;justify-content:center;color:var(--text-muted);text-decoration:none;transition:all 0.15s ease;"
              onmouseenter="this.style.background='var(--primary-lt)';this.style.color='var(--primary)';this.style.borderColor='var(--primary)'"
              onmouseleave="this.style.background='rgba(255,255,255,0.85)';this.style.color='var(--text-muted)';this.style.borderColor='var(--border)'">
              <i class="fab fa-github" style="font-size:13px;"></i>
            </a>
            <a href="https://x.com/ibnekhalid28" target="_blank" aria-label="X Profile"
              style="width:32px;height:32px;border-radius:8px;border:1px solid var(--border);background:rgba(255,255,255,0.85);display:flex;align-items:center;justify-content:center;color:var(--text-muted);text-decoration:none;transition:all 0.15s ease;"
              onmouseenter="this.style.background='var(--primary-lt)';this.style.color='var(--primary)';this.style.borderColor='var(--primary)'"
              onmouseleave="this.style.background='rgba(255,255,255,0.85)';this.style.color='var(--text-muted)';this.style.borderColor='var(--border)'">
              <i class="fab fa-x-twitter" style="font-size:13px;"></i>
            </a>
            <a href="https://youtube.com/@mibnekhalid" target="_blank" aria-label="YouTube Channel"
              style="width:32px;height:32px;border-radius:8px;border:1px solid var(--border);background:rgba(255,255,255,0.85);display:flex;align-items:center;justify-content:center;color:var(--text-muted);text-decoration:none;transition:all 0.15s ease;"
              onmouseenter="this.style.background='rgba(220,38,38,0.10)';this.style.color='#dc2626';this.style.borderColor='rgba(220,38,38,0.30)'"
              onmouseleave="this.style.background='rgba(255,255,255,0.85)';this.style.color='var(--text-muted)';this.style.borderColor='var(--border)'">
              <i class="fab fa-youtube" style="font-size:13px;"></i>
            </a>
          </div>
        </div>

        <!-- Nav links -->
        <div style="display:flex;flex-direction:column;gap:0.6rem;">
          <h4 style="font-family:var(--font-headings);font-size:11px;font-weight:700;color:var(--text);text-transform:uppercase;letter-spacing:0.08em;margin-bottom:0.3rem;">Navigation</h4>
          <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:0.4rem;">
            <li><a href="/" style="font-size:12px;color:var(--text-muted);text-decoration:none;transition:color 0.15s;" onmouseenter="this.style.color='var(--primary)'" onmouseleave="this.style.color='var(--text-muted)'">Course Catalog</a></li>
            <li><a href="/materials" style="font-size:12px;color:var(--text-muted);text-decoration:none;transition:color 0.15s;" onmouseenter="this.style.color='var(--primary)'" onmouseleave="this.style.color='var(--text-muted)'">Materials Archive</a></li>
            <li><a href="/dashboard" style="font-size:12px;color:var(--text-muted);text-decoration:none;transition:color 0.15s;" onmouseenter="this.style.color='var(--primary)'" onmouseleave="this.style.color='var(--text-muted)'">Admin Console</a></li>
            <li><a href="https://mbktech.org/#about" target="_blank" style="font-size:12px;color:var(--text-muted);text-decoration:none;transition:color 0.15s;" onmouseenter="this.style.color='var(--primary)'" onmouseleave="this.style.color='var(--text-muted)'">About the Project</a></li>
          </ul>
        </div>

        <!-- Resources -->
        <div style="display:flex;flex-direction:column;gap:0.6rem;">
          <h4 style="font-family:var(--font-headings);font-size:11px;font-weight:700;color:var(--text);text-transform:uppercase;letter-spacing:0.08em;margin-bottom:0.3rem;">Publications</h4>
          <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:0.4rem;">
            <li><a href="https://blog.mbktech.org" target="_blank" style="font-size:12px;color:var(--text-muted);text-decoration:none;transition:color 0.15s;" onmouseenter="this.style.color='var(--primary)'" onmouseleave="this.style.color='var(--text-muted)'">Academic Blog</a></li>
            <li><a href="https://privacy.mbktech.org" target="_blank" style="font-size:12px;color:var(--text-muted);text-decoration:none;transition:color 0.15s;" onmouseenter="this.style.color='var(--primary)'" onmouseleave="this.style.color='var(--text-muted)'">Privacy Policy</a></li>
            <li><a href="https://github.com/MIbnEKhalid/UnilibWebApp" target="_blank" style="font-size:12px;color:var(--text-muted);text-decoration:none;transition:color 0.15s;" onmouseenter="this.style.color='var(--primary)'" onmouseleave="this.style.color='var(--text-muted)'">GitHub Repository</a></li>
          </ul>
        </div>

        <!-- Inquiries -->
        <div style="display:flex;flex-direction:column;gap:0.6rem;">
          <h4 style="font-family:var(--font-headings);font-size:11px;font-weight:700;color:var(--text);text-transform:uppercase;letter-spacing:0.08em;margin-bottom:0.3rem;">Inquiries</h4>
          <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:0.5rem;">
            <li style="display:flex;align-items:center;gap:0.45rem;">
              <i class="fas fa-envelope" style="font-size:11px;color:var(--text-muted);"></i>
              <a href="mailto:support@mbktech.org" style="font-size:12px;color:var(--text-muted);text-decoration:none;transition:color 0.15s;" onmouseenter="this.style.color='var(--primary)'" onmouseleave="this.style.color='var(--text-muted)'">support@mbktech.org</a>
            </li>
            <li style="display:flex;align-items:center;gap:0.45rem;">
              <i class="fas fa-life-ring" style="font-size:11px;color:var(--text-muted);"></i>
