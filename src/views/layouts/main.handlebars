<!DOCTYPE html>
<html lang="en" dir="ltr" class="scroll-smooth">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description"
    content="{{#if singleBookView}}{{#each books}}{{this.name}} - {{this.description}}{{/each}}{{else}}Access university course materials, books, lab manuals, and assignments on Unilib.{{/if}}">
  <meta name="keywords" content="Unilib, mbktech.org, Course Materials, Books, Lab Manuals, Assignments, University, Open-Source">
  <meta property="og:title" content="Unilib | University Course Materials & Resources" />
  <meta property="og:description"
    content="Empowering academic growth through open-source education and organized course resources." />
  <meta property="og:image" content="https://mbktech.org/Assets/Images/Icon/logo.png" />
  <meta property="og:url" content="https://mbktech.org/">
  <meta name="robots" content="noindex, follow">

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "EducationalOrganization",
      "name": "Unilib - mbktech.org",
      "url": "https://mbktech.org/",
      "logo": "https://mbktech.org/Assets/Images/Icon/logo.png",
      "description": "Empowering students through accessible academic course materials and open-source innovation."
    }
  </script>

  <link rel="icon" type="image/svg+xml" href="/Assets/icon.svg">
  
  <!-- Google Fonts: Lora (Classic Serif) + Inter (Sans) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,500;0,600;0,700;1,400;1,600&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

  <!-- FontAwesome 6 Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />

  <!-- Compiled Tailwind CSS & Theme Stylesheet -->
  <link rel="stylesheet" href="/Assets/Styles/tailwind.css?v={{appVersion}}">
  <link rel="stylesheet" href="/Assets/Styles/theme.css?v={{appVersion}}">
  <link rel="stylesheet" href="/Assets/Styles/common-admin.css?v={{appVersion}}">

  <script src="/mbkauthe/main.js" defer></script>
  <script>
    window.DEFAULT_SEMESTER = "{{defaultSemester}}";
  </script>
  <script src="/Assets/Scripts/unilib.js?v={{appVersion}}" defer></script>
  
  {{{_sections.head}}}

  <title>{{#if singleBookView}}{{#each books}}{{this.name}} - {{/each}}{{/if}}Unilib | Academic University Library</title>
</head>

<body class="bg-[#faf9f6] text-[#1c1917] min-h-screen flex flex-col antialiased selection:bg-amber-100 selection:text-amber-900">

  <!-- Classic Header Navigation -->
  <header class="sticky top-0 z-50 w-full bg-white border-b border-stone-200 shadow-sm" id="mainHeader">
    <div class="h-1 bg-[#162e4a] w-full"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      
      <!-- Brand Crest & Classical Logo -->
      <a href="/" class="flex items-center gap-3 group focus:outline-none">
        <div class="w-10 h-10 rounded bg-[#162e4a] flex items-center justify-center text-white shadow-sm border border-[#0f2035]">
          <i class="fas fa-book-open text-base text-amber-100"></i>
        </div>
        <div class="flex flex-col">
          <span class="font-serif font-bold text-xl tracking-tight text-[#162e4a] leading-none">
            Uni<span class="text-amber-700 italic">lib</span>
          </span>
          <span class="text-[10px] font-semibold text-stone-500 uppercase tracking-widest mt-0.5">MBKTech.org</span>
        </div>
      </a>

      <!-- Desktop Navigation Menu -->
      <nav class="hidden md:flex items-center gap-1">
        <a href="/" class="px-3.5 py-2 rounded text-xs font-semibold text-stone-700 hover:text-[#162e4a] hover:bg-stone-100 transition-colors flex items-center gap-1.5 uppercase tracking-wider">
          <i class="fas fa-book-bookmark text-stone-400 text-[11px]"></i>
          <span>Catalog</span>
        </a>
        <a href="/materials" class="px-3.5 py-2 rounded text-xs font-semibold text-stone-700 hover:text-[#162e4a] hover:bg-stone-100 transition-colors flex items-center gap-1.5 uppercase tracking-wider">
          <i class="fas fa-archive text-stone-400 text-[11px]"></i>
          <span>Materials</span>
        </a>
        <a href="https://mbktech.org/" target="_blank" class="px-3.5 py-2 rounded text-xs font-semibold text-stone-700 hover:text-[#162e4a] hover:bg-stone-100 transition-colors flex items-center gap-1.5 uppercase tracking-wider">
          <i class="fas fa-arrow-up-right-from-square text-stone-400 text-[11px]"></i>
          <span>MBK Tech</span>
        </a>
        <a href="/dashboard" class="px-3.5 py-2 rounded text-xs font-semibold text-stone-700 hover:text-[#162e4a] hover:bg-stone-100 transition-colors flex items-center gap-1.5 uppercase tracking-wider">
          <i class="fas fa-compass text-stone-400 text-[11px]"></i>
          <span>Admin</span>
        </a>

        <div class="ml-3 pl-3 border-l border-stone-200 flex items-center">
          {{> profilemenu}}
        </div>
      </nav>

      <!-- Mobile Menu Toggle Button -->
      <div class="flex items-center gap-2 md:hidden">
        <button id="mobileMenuToggle" type="button" aria-label="Toggle Navigation Menu" class="w-9 h-9 rounded bg-stone-100 border border-stone-300 text-stone-700 flex items-center justify-center hover:bg-stone-200 transition-colors focus:outline-none focus:ring-2 focus:ring-[#162e4a]">
          <i class="fas fa-bars text-sm" id="menuIcon"></i>
        </button>
      </div>

    </div>

    <!-- Mobile Drawer Menu -->
    <div id="mobileDrawer" class="hidden md:hidden border-t border-stone-200 bg-white px-5 py-4 transition-all">
      <div class="flex flex-col gap-1.5">
        <a href="/" class="flex items-center gap-2.5 px-3 py-2 rounded text-stone-700 hover:bg-stone-100 hover:text-[#162e4a] text-xs font-semibold uppercase tracking-wider transition-colors">
          <i class="fas fa-book-bookmark text-stone-400 w-4"></i>
          <span>Course Catalog</span>
        </a>
        <a href="/materials" class="flex items-center gap-2.5 px-3 py-2 rounded text-stone-700 hover:bg-stone-100 hover:text-[#162e4a] text-xs font-semibold uppercase tracking-wider transition-colors">
          <i class="fas fa-archive text-stone-400 w-4"></i>
          <span>Materials</span>
        </a>
        <a href="https://mbktech.org/" target="_blank" class="flex items-center gap-2.5 px-3 py-2 rounded text-stone-700 hover:bg-stone-100 hover:text-[#162e4a] text-xs font-semibold uppercase tracking-wider transition-colors">
          <i class="fas fa-globe text-stone-400 w-4"></i>
          <span>MBK Tech</span>
        </a>
        <a href="/dashboard" class="flex items-center gap-2.5 px-3 py-2 rounded text-stone-700 hover:bg-stone-100 hover:text-[#162e4a] text-xs font-semibold uppercase tracking-wider transition-colors">
          <i class="fas fa-compass text-stone-400 w-4"></i>
          <span>Admin Dashboard</span>
        </a>
      </div>
    </div>
  </header>

  <!-- Main Body Content -->
  <main class="flex-1 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 md:py-8">
    {{{body}}}
  </main>

  <!-- Interactive Quick-View Book Modal Container -->
  <div id="quickViewBackdrop" class="quick-view-backdrop">
    <div class="quick-view-modal p-6 sm:p-7 relative border border-stone-300">
      <button onclick="closeQuickView()" class="absolute top-4 right-4 text-stone-400 hover:text-stone-700 p-1.5 rounded hover:bg-stone-100 transition-colors text-base" aria-label="Close modal">
        <i class="fas fa-times"></i>
      </button>

      <div class="grid grid-cols-1 sm:grid-cols-12 gap-6 items-start">
        
        <!-- Quick View Cover -->
        <div class="sm:col-span-4 flex flex-col items-center">
          <div class="w-full max-w-[190px] aspect-[3/4] rounded-lg overflow-hidden border border-stone-300 shadow-sm bg-[#f2f0ec] relative flex items-center justify-center p-2.5">
            <div id="qvCoverBlur" class="absolute inset-0 bg-cover bg-center opacity-15 blur-md scale-110 pointer-events-none"></div>
            <img id="qvCover" src="/BookCovers/BookCover_Template.webp" alt="Book Cover" class="relative z-10 max-h-full max-w-full object-contain rounded-sm shadow-md">
          </div>
          <div class="mt-3 text-center">
            <span id="qvViews" class="text-xs text-stone-600 font-medium bg-stone-100 px-2.5 py-0.5 rounded border border-stone-200">0 views</span>
          </div>
        </div>

        <!-- Quick View Metadata & Actions -->
        <div class="sm:col-span-8 space-y-4">
          <div class="space-y-1.5 pr-6">
            <div class="flex flex-wrap items-center gap-1.5">
              <span id="qvSemester" class="px-2 py-0.5 rounded text-[11px] font-semibold bg-[#f0f4f9] text-[#1b3f68] border border-[#dce5f0]">Semester</span>
              <span id="qvCategory" class="px-2 py-0.5 rounded text-[11px] font-semibold bg-stone-100 text-stone-700 border border-stone-200">Category</span>
            </div>
            <h2 id="qvTitle" class="font-serif font-bold text-xl text-stone-900 leading-snug">Book Title</h2>
            <p id="qvDescription" class="text-xs sm:text-sm text-stone-600 leading-relaxed max-h-36 overflow-y-auto whitespace-pre-line pr-1">Book description...</p>
          </div>

          <!-- Quick Actions -->
          <div class="pt-3 border-t border-stone-100 flex flex-wrap items-center gap-2">
            <button id="qvReadLink" class="inline-flex items-center gap-1.5 px-4 py-2 rounded bg-[#162e4a] hover:bg-[#0f2035] text-white font-medium text-xs shadow-sm transition-colors">
              <i class="fas fa-book-reader"></i>
              <span>Read Online</span>
            </button>

            <button id="qvDownloadBtn" class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded bg-emerald-700 hover:bg-emerald-800 text-white font-medium text-xs shadow-sm transition-colors">
              <i class="fas fa-download"></i>
              <span>Download</span>
            </button>

            <a id="qvFullPageLink" href="#" class="inline-flex items-center gap-1 px-3 py-2 rounded bg-stone-100 hover:bg-stone-200 text-stone-700 border border-stone-300 text-xs font-semibold transition-colors">
              <span>View Full Entry</span>
              <i class="fas fa-arrow-right text-[10px]"></i>
            </a>
          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- Classic Academic Footer -->
  <footer class="w-full bg-[#f4f2ee] border-t border-stone-300 text-stone-600 mt-16 pt-12 pb-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-8 pb-10 border-b border-stone-300">
        
        <!-- Brand Summary -->
        <div class="lg:col-span-2 flex flex-col gap-3">
          <div class="flex items-center gap-2.5">
            <div class="w-8 h-8 rounded bg-[#162e4a] flex items-center justify-center text-white text-xs border border-[#0f2035]">
              <i class="fas fa-book-open text-amber-100"></i>
            </div>
            <span class="font-serif font-bold text-lg text-[#162e4a]">
              Uni<span class="text-amber-700 italic">lib</span>
            </span>
          </div>
          <p class="text-xs text-stone-600 leading-relaxed max-w-sm">
            An open-source academic repository of curriculum textbooks, laboratory manuals, and educational resources.
          </p>
          <div class="flex items-center gap-2 pt-1">
            <a href="https://github.com/MIbnEKhalid" target="_blank" aria-label="GitHub Profile" class="w-8 h-8 rounded border border-stone-300 bg-white flex items-center justify-center text-stone-600 hover:text-[#162e4a] hover:border-stone-400 transition-colors">
              <i class="fab fa-github text-sm"></i>
            </a>
            <a href="https://x.com/ibnekhalid28" target="_blank" aria-label="Twitter X Profile" class="w-8 h-8 rounded border border-stone-300 bg-white flex items-center justify-center text-stone-600 hover:text-[#162e4a] hover:border-stone-400 transition-colors">
              <i class="fab fa-x-twitter text-sm"></i>
            </a>
            <a href="https://youtube.com/@mibnekhalid" target="_blank" aria-label="YouTube Channel" class="w-8 h-8 rounded border border-stone-300 bg-white flex items-center justify-center text-stone-600 hover:text-rose-700 hover:border-rose-300 transition-colors">
              <i class="fab fa-youtube text-sm"></i>
            </a>
          </div>
        </div>

        <!-- Quick Links -->
        <div class="flex flex-col gap-2.5">
          <h4 class="font-serif font-bold text-xs text-stone-900 uppercase tracking-wider">Navigation</h4>
          <ul class="space-y-1.5 text-xs">
            <li><a href="/" class="hover:text-[#162e4a] transition-colors">Course Catalog</a></li>
            <li><a href="/materials" class="hover:text-[#162e4a] transition-colors">Materials Archive</a></li>
            <li><a href="/dashboard" class="hover:text-[#162e4a] transition-colors">Admin Console</a></li>
            <li><a href="https://mbktech.org/#about" target="_blank" class="hover:text-[#162e4a] transition-colors">About the Project</a></li>
          </ul>
        </div>

        <!-- Resources -->
        <div class="flex flex-col gap-2.5">
          <h4 class="font-serif font-bold text-xs text-stone-900 uppercase tracking-wider">Publications</h4>
          <ul class="space-y-1.5 text-xs">
            <li><a href="https://blog.mbktech.org" target="_blank" class="hover:text-[#162e4a] transition-colors">Academic Blog</a></li>
            <li><a href="https://privacy.mbktech.org" target="_blank" class="hover:text-[#162e4a] transition-colors">Privacy Policy</a></li>
            <li><a href="https://github.com/MIbnEKhalid/UnilibWebApp" target="_blank" class="hover:text-[#162e4a] transition-colors">GitHub Repository</a></li>
          </ul>
        </div>

        <!-- Support -->
        <div class="flex flex-col gap-2.5">
          <h4 class="font-serif font-bold text-xs text-stone-900 uppercase tracking-wider">Inquiries</h4>
          <ul class="space-y-2 text-xs">
            <li class="flex items-center gap-1.5">
              <i class="fas fa-envelope text-stone-400"></i>
              <a href="mailto:support@mbktech.org" class="hover:text-[#162e4a] transition-colors">support@mbktech.org</a>
            </li>
            <li class="flex items-center gap-1.5">
              <i class="fas fa-life-ring text-stone-400"></i>
              <a href="https://mbktech.org/Support" target="_blank" class="hover:text-[#162e4a] transition-colors">Help Center</a>
            </li>
          </ul>
        </div>

      </div>

      <!-- Footer Bottom -->
      <div class="pt-6 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-stone-500">
        <p>&copy; <script>document.write(new Date().getFullYear())</script> mbktech.org. All rights reserved.</p>
        <p class="flex items-center gap-3">
          <a href="https://privacy.mbktech.org" target="_blank" class="hover:text-stone-800 transition-colors">Privacy Policy</a>
          <span>&bull;</span>
          <a href="https://github.com/MIbnEKhalid/UnilibWebApp" target="_blank" class="hover:text-stone-800 transition-colors">MIT Open Source</a>
        </p>
      </div>
    </div>
  </footer>

  <!-- Scroll to Top Button -->
  <button id="scrollToTopBtn" aria-label="Scroll to top" class="fixed bottom-6 right-6 z-40 w-10 h-10 rounded bg-[#162e4a] hover:bg-[#0f2035] text-white shadow-md flex items-center justify-center text-sm opacity-0 pointer-events-none translate-y-3 transition-all duration-200">
    <i class="fas fa-arrow-up text-amber-100"></i>
  </button>
</body>

</html>