  <button type="button" class="semester-tab" data-semester="Semester 5" onclick="{{#if tabHandler}}{{tabHandler}}{{else}}selectSemesterTab{{/if}}('Semester 5')">Semester 5</button>
  <button type="button" class="semester-tab" data-semester="Semester 6" onclick="{{#if tabHandler}}{{tabHandler}}{{else}}selectSemesterTab{{/if}}('Semester 6')">Semester 6</button>
  <button type="button" class="semester-tab" data-semester="Semester 7" onclick="{{#if tabHandler}}{{tabHandler}}{{else}}selectSemesterTab{{/if}}('Semester 7')">Semester 7</button>
