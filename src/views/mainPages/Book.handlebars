{{#section 'head'}}
<title>Admin Registry | Unilib Course Materials</title>
<link rel="stylesheet" href="/Assets/Styles/common-admin.css?v={{appVersion}}">
{{/section}}

<section class="w-full space-y-5" id="books">
  
  <!-- Dashboard Page Header & Stats Summary -->
  <div class="bg-white rounded-lg p-5 border border-stone-300 shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div class="space-y-1">
      <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded text-[11px] font-semibold bg-[#f0f4f9] text-[#162e4a] border border-[#bad0e4]">
        <i class="fas fa-compass text-[10px]"></i>
        <span class="uppercase tracking-wider">Academic Catalog Registry</span>
      </div>
      <h1 class="font-serif font-bold text-xl sm:text-2xl text-stone-900 tracking-normal">
        Curriculum Material Registry
      </h1>
      <p class="text-xs text-stone-600">
        Catalog, configure, inspect consults, manage chapter syllabi, or export digital records.
      </p>
    </div>

    <!-- Top Action Buttons -->
    <div class="flex flex-wrap items-center gap-2">
      <button onclick="exportBooks()" class="inline-flex items-center gap-1.5 px-3 py-2 rounded bg-white hover:bg-stone-50 text-stone-700 border border-stone-300 text-xs font-semibold uppercase tracking-wider shadow-sm transition-colors">
        <i class="fas fa-file-export text-stone-500"></i>
        <span>Export JSON</span>
      </button>

      <a href="/dashboard/Book/Add" class="inline-flex items-center gap-1.5 px-4 py-2 rounded bg-[#162e4a] hover:bg-[#0f2035] text-white text-xs font-semibold uppercase tracking-wider shadow-sm transition-colors">
        <i class="fas fa-plus text-amber-100"></i>
        <span>New Publication</span>
      </a>
    </div>
  </div>

  <!-- Admin Sub-Navigation Tabs -->
  <div class="flex items-center gap-2 border-b border-stone-200 pb-2">
    <a href="/dashboard" class="px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-[#162e4a] text-white flex items-center gap-1.5 uppercase tracking-wider shadow-xs">
      <i class="fas fa-book-bookmark text-amber-200 text-[11px]"></i>
      <span>Book Publications</span>
    </a>
    <a href="/dashboard/Materials" class="px-3.5 py-1.5 rounded-lg text-xs font-semibold text-stone-600 hover:text-stone-900 hover:bg-stone-100 transition-colors flex items-center gap-1.5 uppercase tracking-wider">
      <i class="fas fa-archive text-stone-400 text-[11px]"></i>
      <span>Course Materials</span>
    </a>
  </div>

  <!-- Top Semester 1-Click Tabstrip Partial -->
  {{> semesterTabs}}

  <!-- Faceted Search & Layout Switcher Toolbar -->
  <div class="bg-white rounded-lg p-3 border border-stone-300 shadow-sm">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-3">
      
      <!-- Search & Category Filters -->
      <div class="flex flex-1 flex-col sm:flex-row items-center gap-2.5">
        <div class="relative w-full sm:max-w-md">
          <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-stone-400">
            <i class="fas fa-search text-xs"></i>
          </div>
          <input type="text" id="searchProduct" value="{{filters.search}}" placeholder="Search catalog by title, author... (Press '/')" aria-label="Search books" class="input-classic w-full pl-8 pr-8 py-1.5 text-xs">
          
          <button type="button" id="clearSearch" aria-label="Clear search" class="absolute inset-y-0 right-0 pr-2.5 flex items-center text-stone-400 hover:text-stone-700" style="display: {{#if filters.search}}flex{{else}}none{{/if}};">
            <i class="fas fa-times text-xs bg-stone-100 p-0.5 rounded-full"></i>
          </button>
        </div>

        <!-- Category Dropdown -->
        <div class="relative w-full sm:w-44">
          <select id="categoryFilter" onchange="filterProducts()" aria-label="Filter by Category" class="input-classic w-full px-2.5 py-1.5 text-xs appearance-none cursor-pointer">
            <option value="all" {{#if (or (eq filters.category 'all') (not filters.category))}}selected{{/if}}>All Categories</option>
            <option value="CourseBooks" {{#if (eq filters.category 'CourseBooks')}}selected{{/if}}>Course Books</option>
            <option value="Softwares" {{#if (eq filters.category 'Softwares')}}selected{{/if}}>Softwares</option>
            <option value="LabManuals" {{#if (eq filters.category 'LabManuals')}}selected{{/if}}>Lab Manuals</option>
            <option value="Other" {{#if (or (eq filters.category 'Other') (eq filters.category 'other'))}}selected{{/if}}>Other</option>
          </select>
          <div class="absolute inset-y-0 right-0 pr-2.5 flex items-center pointer-events-none text-stone-400">
            <i class="fas fa-chevron-down text-[8px]"></i>
          </div>
        </div>
      </div>

      <!-- View Mode & Results Counter -->
      <div class="flex items-center justify-between sm:justify-end gap-3 pt-2 sm:pt-0 border-t sm:border-t-0 border-stone-100">
        <span class="text-xs text-stone-600">
          <strong>{{pagination.total}}</strong> publications listed
        </span>

        <!-- Grid vs List View Toggle -->
        <div class="flex items-center p-0.5 rounded border border-stone-300 bg-stone-50">
          <button type="button" id="viewGridBtn" onclick="setViewMode('grid')" title="Grid View" class="p-1.5 rounded text-xs font-semibold transition-colors bg-[#f0f4f9] text-[#162e4a] border border-[#bad0e4]">
            <i class="fas fa-th-large"></i>
          </button>
          <button type="button" id="viewListBtn" onclick="setViewMode('list')" title="List View" class="p-1.5 rounded text-xs font-semibold transition-colors text-stone-500 border border-transparent">
            <i class="fas fa-list"></i>
          </button>
        </div>
      </div>

    </div>
  </div>

  <!-- Bulk Actions Toolbar -->
  <div id="bulkActionsBar" class="hidden items-center justify-between gap-3 p-3 rounded bg-stone-100 border border-stone-300 shadow-sm animate-fadeIn">
    <div class="flex items-center gap-2">
      <label class="flex items-center gap-2 cursor-pointer text-xs font-semibold text-stone-800 select-none">
        <input type="checkbox" id="selectAllBooks" onchange="toggleSelectAll(this)" class="w-4 h-4 rounded text-[#162e4a] bg-white border-stone-300 focus:ring-[#162e4a]">
        <span id="selectedCount" class="text-[#162e4a]">0 selected</span>
      </label>
    </div>

    <div class="flex items-center gap-2">
      <button onclick="bulkHideBooks()" class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded bg-amber-100 hover:bg-amber-200 text-amber-900 border border-amber-300 text-xs font-semibold transition-colors">
        <i class="fas fa-eye-slash text-[10px]"></i>
        <span>Hide Selected</span>
      </button>

      <button onclick="bulkShowBooks()" class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded bg-emerald-100 hover:bg-emerald-200 text-emerald-900 border border-emerald-300 text-xs font-semibold transition-colors">
        <i class="fas fa-eye text-[10px]"></i>
        <span>Show Selected</span>
      </button>

      <button onclick="clearSelection()" class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded bg-white hover:bg-stone-200 text-stone-700 border border-stone-300 text-xs font-semibold transition-colors">
        <i class="fas fa-times text-[10px]"></i>
        <span>Clear</span>
      </button>
    </div>
  </div>

  <!-- Books Management Catalog (Supports both Grid and List View dynamically) -->
  {{#if books}}
  <div id="catalogContainer" class="view-grid">
    {{#each books}}
    
    <!-- 1. Visual Admin Card (Grid Mode) -->
    <article class="item-grid-card bg-white rounded-lg border border-stone-300 overflow-hidden flex flex-col hover:border-stone-400 hover:shadow-md transition-all duration-200 relative" id="grid_admin_{{this.id}}">
      
      <!-- Selection Checkbox -->
      <div class="absolute top-2.5 left-2.5 z-30">
        <input type="checkbox" class="book-select-checkbox w-4 h-4 rounded text-[#162e4a] bg-white border-stone-300 focus:ring-[#162e4a] cursor-pointer shadow-sm" data-book-id="{{this.id}}" onchange="updateBulkActions()" aria-label="Select {{this.name}}">
      </div>

      <!-- Book Cover Image with Ambient Stage & Contained Cover -->
      <div class="relative aspect-[3/4] bg-[#f2f0ec] overflow-hidden border-b border-stone-200 flex items-center justify-center p-3 group/cover">
        <div class="absolute inset-0 bg-cover bg-center opacity-15 blur-md scale-110 pointer-events-none" style="background-image: url('{{this.imageURL}}');"></div>

        <!-- Badges Overlay -->
        <div class="absolute top-2 right-2 z-20 flex flex-col items-end gap-1 pointer-events-none">
          {{#if this.main}}
            {{#unless (eq this.category 'LabManuals')}}
            <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-amber-600 text-white shadow-sm flex items-center gap-1">
              <i class="fas fa-star text-[8px]"></i> Main
            </span>
            {{/unless}}
          {{/if}}

          {{#unless this.visible}}
          <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-rose-100 text-rose-800 border border-rose-300 shadow-sm flex items-center gap-1">
            <i class="fas fa-eye-slash text-[8px]"></i> Hidden
          </span>
          {{else}}
          <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-emerald-100 text-emerald-800 border border-emerald-300 shadow-sm flex items-center gap-1">
            <i class="fas fa-check text-[8px]"></i> Visible
          </span>
          {{/unless}}

          {{#if this.semester}}
          <span class="px-2 py-0.5 rounded text-[10px] font-semibold bg-white/95 text-stone-800 border border-stone-300 shadow-sm">
            {{formatSemesterBadge this.semester}}
          </span>
          {{/if}}
        </div>

        <!-- Centered Contained Cover -->
        <a href="/dashboard/Book/Edit/{{this.id}}" class="relative z-10 w-full h-full flex items-center justify-center" aria-label="Edit {{this.name}}">
          <img src="{{this.imageURL}}" alt="Cover of {{this.name}}" class="max-h-full max-w-full object-contain rounded-sm shadow-md transition-transform duration-300 group-hover/cover:scale-105" loading="lazy" onerror="this.src='/BookCovers/BookCover_Template.webp'">
        </a>
      </div>

      <!-- Book Info & Actions -->
      <div class="p-4 flex-1 flex flex-col justify-between space-y-3">
        <div class="space-y-1">
          <h3 class="font-serif font-bold text-sm text-stone-900 hover:text-[#162e4a] transition-colors line-clamp-1">
            <a href="/dashboard/Book/Edit/{{this.id}}" title="{{this.name}}">{{this.name}}</a>
          </h3>
          <p class="text-xs text-stone-600 line-clamp-2 leading-relaxed" title="{{this.description}}">
            {{this.description}}
          </p>
          {{#if this.UserName}}
          <p class="text-[11px] text-stone-400 flex items-center gap-1 pt-0.5">
            <i class="fas fa-user-edit text-stone-300"></i>
            <span>Curated by: {{this.UserName}}</span>
          </p>
          {{/if}}
        </div>

        <!-- Action Buttons -->
        <div class="pt-2.5 border-t border-stone-100 flex items-center justify-between gap-2">
          <a href="/dashboard/Book/Edit/{{this.id}}" class="flex-1 inline-flex items-center justify-center gap-1 py-1.5 px-3 rounded bg-[#f0f4f9] hover:bg-[#162e4a] text-[#162e4a] hover:text-white text-xs font-semibold uppercase tracking-wider border border-[#bad0e4] hover:border-[#162e4a] transition-colors">
            <i class="fas fa-edit text-[10px]"></i>
            <span>Edit</span>
          </a>

          <a href="/dashboard/Book/{{this.id}}/Sections" class="inline-flex items-center justify-center p-1.5 rounded bg-stone-100 hover:bg-stone-200 text-stone-700 text-xs border border-stone-300 transition-colors" title="Manage Chapters">
            <i class="fas fa-list-ul"></i>
          </a>

          <button onclick="deleteProduct('{{this.id}}')" class="inline-flex items-center justify-center p-1.5 rounded bg-stone-100 hover:bg-rose-700 text-rose-700 hover:text-white text-xs border border-stone-300 hover:border-rose-700 transition-colors" title="Delete Entry">
            <i class="fas fa-trash-alt"></i>
          </button>
        </div>

      </div>

    </article>

    <!-- 2. Compact Admin Row (List Mode) -->
    <article class="item-list-row bg-white rounded-lg border border-stone-300 p-3 sm:p-4 hover:border-stone-400 hover:shadow-sm transition-all flex flex-col sm:flex-row sm:items-center justify-between gap-3 sm:gap-4" id="list_admin_{{this.id}}">
      
      <div class="flex items-center gap-3 min-w-0 flex-1">
        <input type="checkbox" class="book-select-checkbox w-4 h-4 rounded text-[#162e4a] bg-white border-stone-300 focus:ring-[#162e4a] cursor-pointer shadow-sm flex-shrink-0" data-book-id="{{this.id}}" onchange="updateBulkActions()" aria-label="Select {{this.name}}">
        
        <div class="w-12 h-16 rounded bg-[#f2f0ec] border border-stone-300 p-0.5 flex items-center justify-center overflow-hidden flex-shrink-0">
          <img src="{{this.imageURL}}" alt="Cover" class="max-h-full max-w-full object-contain rounded-xs" loading="lazy" onerror="this.src='/BookCovers/BookCover_Template.webp'">
        </div>

        <div class="min-w-0 space-y-1">
          <div class="flex flex-wrap items-center gap-1.5">
            {{#if this.main}}
            <span class="px-1.5 py-0.2 rounded text-[10px] font-bold bg-amber-600 text-white">Main</span>
            {{/if}}

            {{#unless this.visible}}
            <span class="px-2 py-0.5 rounded text-[10px] font-semibold bg-rose-100 text-rose-800 border border-rose-300">Hidden</span>
            {{else}}
            <span class="px-2 py-0.5 rounded text-[10px] font-semibold bg-emerald-100 text-emerald-800 border border-emerald-300">Visible</span>
            {{/unless}}

            <span class="px-2 py-0.5 rounded text-[11px] font-semibold bg-[#f0f4f9] text-[#162e4a] border border-[#bad0e4]">{{formatSemesterBadge this.semester}}</span>
            <span class="px-2 py-0.5 rounded text-[11px] font-medium bg-stone-100 text-stone-700 border border-stone-200">{{this.category}}</span>
            <span class="text-[11px] text-stone-500"><i class="fas fa-eye text-[9px] mr-0.5"></i> {{formatNumber this.views}}</span>
          </div>

          <h3 class="font-serif font-bold text-sm text-stone-900 hover:text-[#162e4a] transition-colors truncate">
            <a href="/dashboard/Book/Edit/{{this.id}}" title="{{this.name}}">{{this.name}}</a>
          </h3>
          <p class="text-xs text-stone-600 truncate" title="{{this.description}}">
            {{this.description}}
          </p>
        </div>
      </div>

      <!-- Actions -->
      <div class="flex items-center gap-2 flex-shrink-0 self-end sm:self-auto">
        <a href="/dashboard/Book/Edit/{{this.id}}" class="inline-flex items-center gap-1 px-3 py-1.5 rounded bg-[#f0f4f9] hover:bg-[#162e4a] text-[#162e4a] hover:text-white border border-[#bad0e4] hover:border-[#162e4a] text-xs font-semibold uppercase tracking-wider transition-colors">
          <i class="fas fa-edit text-[10px]"></i>
          <span>Edit</span>
        </a>

        <a href="/dashboard/Book/{{this.id}}/Sections" class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded bg-stone-100 hover:bg-stone-200 text-stone-700 text-xs font-medium border border-stone-300 transition-colors" title="Manage Chapters">
          <i class="fas fa-list-ul text-[10px]"></i>
          <span>Chapters</span>
        </a>

        <button onclick="deleteProduct('{{this.id}}')" class="inline-flex items-center justify-center p-1.5 rounded bg-stone-100 hover:bg-rose-700 text-rose-700 hover:text-white text-xs border border-stone-300 hover:border-rose-700 transition-colors" title="Delete Entry">
          <i class="fas fa-trash-alt"></i>
        </button>
      </div>

    </article>

    {{/each}}
  </div>

  {{else}}
  <!-- Empty State -->
  <div class="bg-white rounded-lg p-10 text-center max-w-md mx-auto border border-stone-300 space-y-3">
    <div class="w-12 h-12 rounded-full bg-stone-100 flex items-center justify-center mx-auto text-stone-400 text-xl">
      <i class="fas fa-book-open"></i>
    </div>
    <div class="space-y-1">
      <h3 class="font-serif font-bold text-base text-stone-900">No registry publications found</h3>
      <p class="text-xs text-stone-500">Try modifying filters or catalog a new textbook entry.</p>
    </div>
    <button onclick="resetFilters()" class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded bg-[#162e4a] text-white font-medium text-xs hover:bg-[#0f2035] transition-colors">
      <i class="fas fa-filter"></i>
      <span>Reset Filters</span>
    </button>
  </div>
  {{/if}}

  <!-- Pagination Component Partial -->
  {{> pagination label="registry publications"}}

</section>

<script>
  function exportBooks() {
    fetch('/api/admin/Unilib/Book/Export', { credentials: 'include' })
      .then(r => { if (!r.ok) throw new Error('Export failed'); return r.json(); })
      .then(data => {
        const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
        const a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        const ts = new Date().toISOString().replace(/[:.]/g, '-');
        a.download = `unilib-catalog-${ts}.json`;
        document.body.appendChild(a); a.click(); document.body.removeChild(a);
        showToast('Catalog exported successfully!', 'success');
      })
      .catch(err => { 
        console.error(err); 
        showToast('Failed to export catalog.', 'error'); 
      });
  }

  async function deleteProduct(productId) {
    if (!confirm('Are you sure you want to delete this publication from the registry?')) return;
    try {
      const response = await fetch(`/api/admin/Unilib/Book/Delete/${productId}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' }
      });
      if (response.ok) {
        showToast('Publication deleted successfully!', 'success');
        setTimeout(() => window.location.reload(), 800);
      } else {
        showToast('Failed to delete publication.', 'error');
      }
    } catch (error) {
      console.error('Error deleting product:', error);
      showToast('An error occurred while deleting the book.', 'error');
    }
  }

  function updateBulkActions() {
    const checked = Array.from(document.querySelectorAll('.book-select-checkbox:checked'));
    const uniqueBookIds = new Set(checked.map(cb => cb.dataset.bookId));
    const count = uniqueBookIds.size;
    const bulkBar = document.getElementById('bulkActionsBar');
    const countSpan = document.getElementById('selectedCount');

    if (count > 0) {
      countSpan.textContent = `${count} item${count > 1 ? 's' : ''} selected`;
      bulkBar.classList.remove('hidden');
      bulkBar.classList.add('flex');
    } else {
      bulkBar.classList.add('hidden');
      bulkBar.classList.remove('flex');
    }
  }

  function getSelectedBookIds() {
    return Array.from(new Set(Array.from(document.querySelectorAll('.book-select-checkbox:checked')).map(cb => cb.dataset.bookId)));
  }

  function clearSelection() {
    document.querySelectorAll('.book-select-checkbox').forEach(cb => cb.checked = false);
    updateBulkActions();
  }

  function toggleSelectAll(masterCb) {
    document.querySelectorAll('.book-select-checkbox').forEach(cb => cb.checked = masterCb.checked);
    updateBulkActions();
  }

  async function setBulkVisibility(visible) {
    const bookIds = getSelectedBookIds();
    if (bookIds.length === 0) return;
    const action = visible ? 'show' : 'hide';
    if (!confirm(`Are you sure you want to ${action} ${bookIds.length} selected publication(s)?`)) return;

    try {
      const response = await fetch('/api/admin/Unilib/Book/BulkVisibility', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ bookIds, visible })
      });
      const data = await response.json();
      if (response.ok) {
        showToast(data.message || `Publications ${action}n successfully`, 'success');
        setTimeout(() => window.location.reload(), 800);
      } else {
        showToast(data.error || `Failed to ${action} publications`, 'error');
      }
    } catch (error) {
      console.error('Error updating visibility:', error);
      showToast('An error occurred while updating visibility.', 'error');
    }
  }

  const bulkHideBooks = () => setBulkVisibility(false);
  const bulkShowBooks = () => setBulkVisibility(true);
</script>