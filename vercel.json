{
  "version": 2,
  "builds": [
    {
      "src": "src/app.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "views/**",
          "node_modules/mbkauthe/views/**",
          "node_modules/mbkbucket/views/**",
          "node_modules/mbkutils/views/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/src/app.js"
    }
  ]
}