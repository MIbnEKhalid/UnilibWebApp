{
  "version": 2,
  "builds": [
    {
      "src": "src/app.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "views/**",
          "node_modules/mbkauthe/views/**",
          "node_modules/mbkbucket/views/**",
          "node_modules/mbkutils/views/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/assets/(.*)",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "dest": "/public/assets/$1"
    },
    {
      "src": "/BookCovers/(.*)",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "dest": "/public/BookCovers/$1"
    },
    {
      "src": "/robots.txt",
      "headers": {
        "cache-control": "public, max-age=86400"
      },
      "dest": "/public/robots.txt"
    },
    {
      "src": "/favicon.ico",
      "dest": "/public/assets/images/icon.svg"
    },
    {
      "src": "/(.*)",
      "dest": "/src/app.js"
    }
  ]
}